{
  "name": "hinata-desktop",
  "version": "0.1.0",
  "description": "Hinata desktop WebView",
  "author": {
    "name": "Sept Ngiene",
    "email": "contact@eliesept.com"
  },
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "npm run dist:mac",
    "dist:mac": "electron-builder --mac --config.directories.output=Installateurs/MaOS",
    "dist:win": "electron-builder --win nsis --config.directories.output=Installateurs/Windows",
    "dist:web": "node scripts/build-web.js",
    "dist:all": "npm run dist:web && npm run dist:mac && npm run dist:win"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.eliesept.hinata",
    "productName": "Hinata",
    "icon": "build/icon.icns",
    "files": [
      "desktop/**/*",
      "Hinata/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
